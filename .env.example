# Autonomous Enterprise Intelligence System - Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit real secrets.

APP_NAME="Autonomous Enterprise Intelligence System"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-64-char-secret-in-production

# Database (PostgreSQL + pgvector recommended for production; SQLite async supported for local dev)
DATABASE_URL=sqlite+aiosqlite:///./enterprise_intelligence.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_intelligence

# Vector Store (local_hybrid or qdrant or pgvector)
VECTOR_BACKEND=local_hybrid
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (optional for caching and pub/sub)
REDIS_URL=

# LLM Providers (configure at least one for live LLM reasoning; otherwise deterministic structured mode is used)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Web Search & Research Tools (optional; DuckDuckGo/HTTP fallback available)
TAVILY_API_KEY=
SERPER_API_KEY=

# Memory & Observability (optional)
MEM0_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Security & Execution Limits
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=20
MAX_WORKFLOW_RETRIES=2
AGENT_EXECUTION_TIMEOUT_SECONDS=120
REQUIRE_APPROVAL_FOR_REPORTS=false
